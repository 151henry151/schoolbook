[Unit]
Description=Schoolbook parent console reverse tunnel
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/ssh -NT -o BatchMode=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -o ExitOnForwardFailure=yes -o StrictHostKeyChecking=yes -i /root/.ssh/id_ed25519 -R 127.0.0.1:28766:127.0.0.1:8766 henry@romptele.com
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
