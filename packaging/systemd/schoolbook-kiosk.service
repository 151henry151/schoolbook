[Unit]
Description=Schoolbook kiosk
After=network-online.target NetworkManager.service seatd.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/schoolbook
Environment=HOME=/root
Environment=LANG=en_US.UTF-8
Environment=XDG_RUNTIME_DIR=/run/user/0
Environment=PATH=/root/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/bin
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
ExecStartPre=/bin/mkdir -p /run/user/0
ExecStart=/root/start-schoolbook.sh
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
