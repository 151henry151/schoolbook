<openbox_config xmlns="http://openbox.org/3.4/rc">
  <keyboard>
    <!-- Handled outside Chromium, including when its renderer is stuck. -->
    <keybind key="F11">
      <action name="Execute">
        <command>systemctl --no-block restart schoolbook-kiosk.service</command>
      </action>
    </keybind>
  </keyboard>
</openbox_config>
